# Node modules
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*      # .env.local, .env.production, etc
**/.env
**/.env.*

# Build output
.next/
out/
dist/
build/
